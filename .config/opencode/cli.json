{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "darkvoid"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "high",
    "markdown": "rendered"
  },
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "horizontal",
    "indicators": "status"
  },
  "attention": {
    "notifications": true
  },
  "terminal": {
    "title": false,
    "copy": "select"
  }
}
