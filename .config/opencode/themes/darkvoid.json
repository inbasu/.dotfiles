{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#1c1c1c",
    "fg": "#c0c0c0",
    "comment": "#585858",
    "line_nr": "#404040",
    "visual": "#303030",
    "green": "#1bfd9c",
    "cursor": "#bdfe58",
    "string": "#d1d1d1",
    "func": "#e1e1e1",
    "kw": "#f1f1f1",
    "identifier": "#b1b1b1",
    "type": "#a1a1a1",
    "bracket": "#e6e6e6",
    "bool": "#66b2b2",
    "constant": "#b2d8d8",
    "added": "#baffc9",
    "changed": "#ffffba",
    "removed": "#ffb3ba",
    "error": "#dea6a0",
    "warning": "#d6efd8",
    "hint": "#bedc74",
    "info": "#7fa1c3"
  },
  "theme": {
    "primary": { "dark": "cursor", "light": "cursor" },
    "secondary": { "dark": "green", "light": "green" },
    "accent": { "dark": "green", "light": "green" },
    "error": { "dark": "error", "light": "error" },
    "warning": { "dark": "warning", "light": "warning" },
    "success": { "dark": "added", "light": "added" },
    "info": { "dark": "info", "light": "info" },
    "text": { "dark": "fg", "light": "fg" },
    "textMuted": { "dark": "comment", "light": "comment" },
    "background": { "dark": "none", "light": "bg" },
    "backgroundPanel": { "dark": "bg", "light": "bg" },
    "backgroundElement": { "dark": "visual", "light": "visual" },
    "border": { "dark": "comment", "light": "comment" },
    "borderActive": { "dark": "green", "light": "green" },
    "borderSubtle": { "dark": "line_nr", "light": "line_nr" },
    "diffAdded": { "dark": "added", "light": "added" },
    "diffRemoved": { "dark": "removed", "light": "removed" },
    "diffContext": { "dark": "comment", "light": "comment" },
    "diffHunkHeader": { "dark": "cursor", "light": "cursor" },
    "diffHighlightAdded": { "dark": "added", "light": "added" },
    "diffHighlightRemoved": { "dark": "removed", "light": "removed" },
    "diffAddedBg": { "dark": "bg", "light": "bg" },
    "diffRemovedBg": { "dark": "bg", "light": "bg" },
    "diffContextBg": { "dark": "bg", "light": "bg" },
    "diffLineNumber": { "dark": "line_nr", "light": "line_nr" },
    "diffAddedLineNumberBg": { "dark": "bg", "light": "bg" },
    "diffRemovedLineNumberBg": { "dark": "bg", "light": "bg" },
    "markdownText": { "dark": "fg", "light": "fg" },
    "markdownHeading": { "dark": "cursor", "light": "cursor" },
    "markdownLink": { "dark": "green", "light": "green" },
    "markdownLinkText": { "dark": "cursor", "light": "cursor" },
    "markdownCode": { "dark": "string", "light": "string" },
    "markdownBlockQuote": { "dark": "comment", "light": "comment" },
    "markdownEmph": { "dark": "func", "light": "func" },
    "markdownStrong": { "dark": "kw", "light": "kw" },
    "markdownHorizontalRule": { "dark": "line_nr", "light": "line_nr" },
    "markdownListItem": { "dark": "cursor", "light": "cursor" },
    "markdownListEnumeration": { "dark": "green", "light": "green" },
    "markdownImage": { "dark": "info", "light": "info" },
    "markdownImageText": { "dark": "type", "light": "type" },
    "markdownCodeBlock": { "dark": "fg", "light": "fg" },
    "syntaxComment": { "dark": "comment", "light": "comment" },
    "syntaxKeyword": { "dark": "kw", "light": "kw" },
    "syntaxFunction": { "dark": "func", "light": "func" },
    "syntaxVariable": { "dark": "identifier", "light": "identifier" },
    "syntaxString": { "dark": "string", "light": "string" },
    "syntaxNumber": { "dark": "bool", "light": "bool" },
    "syntaxType": { "dark": "type", "light": "type" },
    "syntaxOperator": { "dark": "green", "light": "green" },
    "syntaxPunctuation": { "dark": "bracket", "light": "bracket" }
  }
}
